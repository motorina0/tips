{
  "id": "tips",
  "name": "Tips",
  "short_description": "Receive Lightning tips with short messages.",
  "version": "0.0.1",
  "min_lnbits_version": "1.5.5",

  "extension_type": "wasm",
  "wasm": {
    "module": "wasm/module.wasm",
    "exports": [
      {
        "name": "create-tip-jar",
        "visibility": "authenticated"
      },
      {
        "name": "update-tip-jar",
        "visibility": "authenticated"
      },
      {
        "name": "list-tip-jars",
        "visibility": "authenticated"
      },
      {
        "name": "delete-tip-jar",
        "visibility": "authenticated"
      },
      {
        "name": "list-tip-jar-tips",
        "visibility": "authenticated"
      },
      {
        "name": "list-tip-wallets",
        "visibility": "authenticated"
      },
      {
        "name": "list-tip-watchonly-wallets",
        "visibility": "authenticated"
      },
      {
        "name": "get-bitcoin-rate",
        "visibility": "authenticated"
      },
      {
        "name": "list-tip-currencies",
        "visibility": "public"
      },
      {
        "name": "get-public-tip-jar",
        "visibility": "public"
      },
      {
        "name": "create-tip-invoice",
        "visibility": "public"
      },
      {
        "name": "record-payment",
        "visibility": "event"
      }
    ]
  },
  "events": {
    "onInvoicePaid": "record-payment"
  },
  "ui_routes": [
    {
      "path": "/tips",
      "entrypoint": "ui/admin.html",
      "auth": "user"
    },
    {
      "path": "/tips/jars/{jar_id}",
      "entrypoint": "ui/public.html",
      "auth": "public",
      "path_params": {
        "jar_id": "jarId"
      }
    }
  ],
  "api_routes": [
    {
      "method": "POST",
      "path": "/jars",
      "export": "create-tip-jar",
      "auth": "user"
    },
    {
      "method": "PUT",
      "path": "/jars/{jar_id}",
      "export": "update-tip-jar",
      "auth": "user",
      "path_params": {
        "jar_id": "jarId"
      }
    },
    {
      "method": "GET",
      "path": "/jars",
      "export": "list-tip-jars",
      "auth": "user"
    },
    {
      "method": "DELETE",
      "path": "/jars/{jar_id}",
      "export": "delete-tip-jar",
      "auth": "user",
      "path_params": {
        "jar_id": "jarId"
      }
    },
    {
      "method": "GET",
      "path": "/jars/{jar_id}/tips",
      "export": "list-tip-jar-tips",
      "auth": "user",
      "path_params": {
        "jar_id": "jarId"
      }
    },
    {
      "method": "GET",
      "path": "/wallets",
      "export": "list-tip-wallets",
      "auth": "user"
    },
    {
      "method": "GET",
      "path": "/watchonly/wallets",
      "export": "list-tip-watchonly-wallets",
      "auth": "user"
    },
    {
      "method": "GET",
      "path": "/rate/bitcoin",
      "export": "get-bitcoin-rate",
      "auth": "user"
    },
    {
      "method": "GET",
      "path": "/currencies",
      "export": "list-tip-currencies",
      "auth": "public"
    },
    {
      "method": "GET",
      "path": "/jars/{jar_id}",
      "export": "get-public-tip-jar",
      "auth": "public",
      "path_params": {
        "jar_id": "jarId"
      }
    },
    {
      "method": "POST",
      "path": "/invoice",
      "export": "create-tip-invoice",
      "auth": "public"
    }
  ],
  "permissions": [
    {
      "id": "ext.storage.read",
      "description": "Read data in the tips extension storage namespace."
    },
    {
      "id": "ext.storage.read_public",
      "description": "Read public tip jar fields for public pages.",
      "policies": [
        {
          "table_name": "tip_jars",
          "public_fields": [
            "id",
            "title",
            "description",
            "payment_method",
            "currency",
            "suggested_amounts",
            "thank_you_message",
            "onchain_address"
          ]
        }
      ]
    },
    {
      "id": "ext.storage.write",
      "description": "Write data in the tips extension storage namespace."
    },
    {
      "id": "ext.storage.append_public",
      "description": "Create pending tip rows from public tip jar pages.",
      "policies": [
        {
          "table": "tips",
          "source_table": "tip_jars",
          "source_id_field": "jar_id",
          "allowed_fields": [
            "amount_sat",
            "name",
            "message",
            "payment_hash",
            "paid",
            "created_at"
          ]
        }
      ]
    },
    {
      "id": "wallet.create_invoice",
      "description": "Create incoming Lightning invoices from authenticated extension pages."
    },
    {
      "id": "wallet.create_invoice_public",
      "description": "Create incoming Lightning invoices for selected wallets.",
      "policies": [
        {
          "table": "tip_jars",
          "wallet_field": "wallet_id"
        }
      ]
    },
    {
      "id": "wallet.pay_invoice_background",
      "description": "Send configured platform support payments after tips are received."
    },
    {
      "id": "wallet.list",
      "description": "Show the installing user's wallets so a tip jar can receive invoices."
    },
    {
      "id": "utils.basic",
      "description": "Use LNbits currency conversion and Lightning invoice utility functions."
    },
    {
      "id": "http.request",
      "description": "Fetch external Bitcoin exchange rates from mempool.space.",
      "policies": [
        {
          "host": "https://mempool.space"
        }
      ]
    },
    {
      "id": "extension.api.request",
      "description": "Read Watchonly accounts and create receive addresses for onchain tip jars.",
      "policies": [
        {
          "id": "watchonly",
          "access": [
            "read"
          ]
        }
      ]
    }
  ]
}
